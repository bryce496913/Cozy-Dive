{
  "name": "cozy-diver",
  "version": "0.4.0-alpha.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test:stress": "vitest run --config validation/vitest.config.ts --maxWorkers=1",
    "build:benchmark": "tsc --noEmit && vite build --mode benchmark"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/draco3dgltf": "^1.4.3",
    "@types/node": "^24.19.2",
    "@types/three": "^0.187.0",
    "draco3dgltf": "^1.5.9",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "ktx2-encoder": "^0.6.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
